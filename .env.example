# ==============================================================================
# Task Tracker Environment Configuration
# ==============================================================================

# Django Secret Key (generate a secure random string in production)
SECRET_KEY=django-insecure-task-tracker-secret-key-yrnovatech-task-5

# Debug mode (True for development, False in production)
DEBUG=True

# Allowed hosts (comma-separated list)
ALLOWED_HOSTS=127.0.0.1,localhost

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# To use PostgreSQL, ensure your PostgreSQL service is running and create the database:
#   CREATE DATABASE task_tracker_db;
#
DB_ENGINE=postgresql
DB_NAME=task_tracker_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Set to True if you want to use SQLite for quick local development/testing without PostgreSQL
USE_SQLITE=False
